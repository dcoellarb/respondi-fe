# Copy to .env.local (dev), .env.staging, or .env.production.
# Those files are gitignored via .env* (this example is opted back in).

# Public site URL used for metadata, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API Gateway stage host. Paths are relative to /api (OpenAPI base).
# Dev example:     https://q3zxmscrjj.execute-api.us-east-2.amazonaws.com/prod/
# Staging:         https://ol6w4lrfz2.execute-api.us-east-2.amazonaws.com/prod/
# Production:      https://lvohd8a11d.execute-api.us-east-2.amazonaws.com/prod/
NEXT_PUBLIC_API_URL=https://q3zxmscrjj.execute-api.us-east-2.amazonaws.com/prod/

# Optional overrides for contact addresses (defaults are set in src/lib/site.ts).
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=

# Optional Search Console verification.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# PostHog (client analytics). Token is the project API key from PostHog.
# Events are sent ONLY when NEXT_PUBLIC_VERCEL_ENV=production (never local/staging/preview).
# Set NEXT_PUBLIC_VERCEL_ENV=production in .env.production only (pnpm deploy loads that file).
# NEXT_PUBLIC_VERCEL_ENV=
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta WhatsApp Embedded Signup (Facebook Login for Business config from App Dashboard).
# App secret / business tokens stay on the backend — only public IDs here.
NEXT_PUBLIC_META_APP_ID=1177795441854369
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=1911047146545886

